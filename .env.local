# Public site URL (no trailing slash). Required for correct canonical URLs, sitemap, and Open Graph in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Browser calls same-origin /api/v1 (Next.js rewrite → Django) so the refresh cookie is first-party.
# Server-side fetch still uses this absolute URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# API_PROXY_TARGET=http://127.0.0.1:8000

# Legacy mock delay (off by default — API mode). Set true only for offline mock demos.
# NEXT_PUBLIC_USE_MOCK_DELAY=false
# NEXT_PUBLIC_MOCK_API_DELAY_MS=320

# Google Maps (optional — map search). Safe to expose; restrict key by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAilP3TtX30W_WmlqKe0EmeLp1h9uBa1l8

# SECURITY: Never prefix secrets with NEXT_PUBLIC_. API keys, JWT secrets, and DB URLs belong on the server only.
